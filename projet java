public class Tamagotchi {

    // Attributs privés

    private int age;

    private int dureeDeVie;

    private int maxEnergie;

    private int energie;

    private String nom;

    // Constructeur

    public Tamagotchi(String nom) {

        this.nom = nom;

        this.age = 0;

        this.dureeDeVie = (int)(Math.random() * 6) + 9;

        this.maxEnergie = (int)(Math.random() * 5) + 5;

        this.energie = (int)(Math.random() * (maxEnergie - 2)) + 3;

    }

    // Afficher l'état

    public void parler() {

        if (energie > 5) {

            System.out.println(nom + " : tout va bien !");

        } else {

            System.out.println(nom + " : je suis affamé !");

        }

    }

    // Nourrir l'animal

    public void manger() {

        if (energie == maxEnergie) {

            System.out.println(nom + " : je n'ai pas faim !");

        } else {

            int nourriture = (int)(Math.random() * 3) + 1;

            energie += nourriture;

            if (energie > maxEnergie) {

                energie = maxEnergie;

            }

            System.out.println(nom + " : Merci !");

        }

    }

    // Vérifier l'âge limite

    public boolean ageLimite() {

        return age >= dureeDeVie;

    }

    // Faire vivre l'animal

    public boolean vivre() {

        if (ageLimite()) {

            return true;

        }

        if (energie <= 0) {

            System.out.println(nom + " : je meurs... Arrrggh !");

            return false;

        }

        age++;

        energie--;

        if (ageLimite()) {

            System.out.println(nom + " : c'est gagné pour moi !");

        } else {

            parler();

        }

        return true;

    }

    // Récupérer le nom

    public String getNom() {

        return nom;

    }

}
